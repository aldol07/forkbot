# Copy to .env and fill in. Everything except the database URL and JWT_SECRET has a sensible default.

# ---------- Database ----------
# Local: the Postgres from docker-compose.yml
DATABASE_URL=postgresql+psycopg://forkbot:forkbot@localhost:5433/forkbot
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (IPv4), with this prefix.
# URL-encode special characters in the password (@ -> %40).
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ---------- Auth ----------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false            # true behind https
# Encrypts the API keys users paste in. Empty = derived from JWT_SECRET (rotating either one means
# users re-enter their keys). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---------- LLM providers ----------
# Users can paste their own keys in a bot's settings tab. These server keys are only a fallback,
# and SERVER_LLM_KEYS=false stops them being used for users' bots at all (recommended for a public deploy).
SERVER_LLM_KEYS=true
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
LLM_FALLBACK_PROVIDER=gemini   # used when the chosen provider rate-limits before answering
REWRITE_MODEL=openai/gpt-oss-20b

# ---------- Retrieval ----------
EMBEDDING_PROVIDER=fastembed   # fastembed (local, no key) | openai | hash (tests)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER=cross-encoder         # cross-encoder | none (none also turns off the "docs only" gate)
RERANK_MIN_SCORE=-6.0          # calibrated with backend/scripts/eval_retrieval.py
RERANK_CANDIDATES=10

# ---------- File storage ----------
STORAGE_BACKEND=local          # local (./storage) | s3 (Supabase Storage, Cloudflare R2, MinIO)
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-southeast-1
# S3_BUCKET=documents
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---------- Limits ----------
MAX_UPLOAD_MB=25
MAX_DOCS_PER_BOT=20
MAX_STORAGE_MB_PER_USER=50
CHAT_RETENTION_DAYS=90

# ---------- Misc ----------
API_DOCS=false                 # true exposes /docs and /openapi.json
