# ---------- Database / cache (matches docker-compose.yml) ----------
DATABASE_URL=postgresql+psycopg://botforge:botforge@localhost:5433/botforge
REDIS_URL=redis://localhost:6380/0

# ---------- Auth ----------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# ---------- Frontend origin (for CORS on the dashboard API) ----------
FRONTEND_ORIGIN=http://localhost:3000

# ---------- Embeddings ----------
# fastembed = local ONNX model, no API key (downloads ~130MB on first use)
# hash      = deterministic toy embeddings, used by tests (no download)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---------- LLM providers (fill in the ones you have) ----------
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
